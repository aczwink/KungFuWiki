{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Main content entry definition",
    "description": "JSON Schema for main content entry definitions",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "description": {
            "type": "string"
        },
        "media": {
            "$ref": "./ContentMediaDefinition.json"
        },
        "tags": {
            "type": "array",
            "items": {
                "$ref": "./Tag.json"
            }
        },
        "taught-by": {
            "type": "string"
        },
        "title": {
            "oneOf": [
                {
                    "$ref": "./ContentTitleDefinition.json"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "./ContentTitleDefinition.json"
                    }
                }
            ]
        }
    },
    "required": ["description", "tags", "title"]
}